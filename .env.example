# Copie este arquivo para .env e preencha (o .env NÃO vai para o GitHub).
# URL: Supabase > Project Settings > Data API (sem /rest/v1 no final)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta: Supabase > Project Settings > API Keys > secret (sb_secret_...) ou service_role
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-secreta
